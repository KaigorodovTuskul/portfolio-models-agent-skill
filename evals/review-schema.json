{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent portfolio skill quality review",
  "type": "object",
  "additionalProperties": false,
  "required": ["round", "role", "score", "independent", "reviewer_model", "reviewer_run_id", "artifact_sha256", "evidence", "blockers", "findings"],
  "properties": {
    "round": {"type": "integer", "minimum": 1},
    "role": {"enum": ["ARCHITECT", "SOURCES", "QUANT", "PRACTICE"]},
    "score": {"type": "number", "minimum": 1, "maximum": 10},
    "independent": {"const": true},
    "reviewer_model": {"type": "string", "minLength": 1},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "path", "finding", "required_fix"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor", "observation"]},
          "path": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "required_fix": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
